generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  username          String             @unique
  email             String             @unique
  password          String
  displayName       String?
  passwordChangedAt DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  workspaces        Workspace[]
  authTokens        AuthToken[]
  researcherProfile ResearcherProfile?
}

model AuthToken {
  id         String    @id
  userId     String
  type       String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
}

model Workspace {
  id              String   @id @default(uuid())
  name            String
  description     String?
  catalysisSystem String
  corpusWorkspaceId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, catalysisSystem])
}

model ResearcherProfile {
  id                          String    @id @default(uuid())
  userId                      String    @unique
  institution                 String?
  role                        String?
  primaryCatalysis            String    @default("undecided")
  molecularSievePreference    String    @default("when_helpful")
  heterojunctionPreference    String    @default("evidence_based")
  riskTolerance               String    @default("balanced")
  researchInterestsJson       String    @default("[]")
  catalystSystemsJson         String    @default("[]")
  techniquesJson              String    @default("[]")
  currentGoalsJson            String    @default("[]")
  researchPrioritiesJson      String    @default("[]")
  availableResourcesJson      String    @default("[]")
  avoidancesJson              String    @default("[]")
  experimentalConstraintsJson String @default("{}")
  preferredOutputStyle        String    @default("evidence_first")
  openResearchContext         String    @default("")
  notes                       String    @default("")
  learnedPreferencesJson      String    @default("[]")
  interviewAnswersJson        String    @default("{}")
  interactionCount            Int       @default(0)
  lastLearnedAt               DateTime?
  onboardingCompletedAt       DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  user                        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
