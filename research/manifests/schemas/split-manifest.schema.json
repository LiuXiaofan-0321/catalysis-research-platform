{
  "$id": "split-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm_version": {
      "const": "fixed_split.v1"
    },
    "configuration": {
      "type": "object"
    },
    "counts": {
      "type": [
        "object",
        "null"
      ]
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "dataset_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "dataset_id": {
      "minLength": 1,
      "type": "string"
    },
    "dataset_version": {
      "minLength": 1,
      "type": "string"
    },
    "folds": {
      "type": [
        "array",
        "null"
      ]
    },
    "git_branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "git_dirty": {
      "type": "boolean"
    },
    "git_tree": {
      "type": [
        "string",
        "null"
      ]
    },
    "manifest_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "observed_ratios": {
      "type": [
        "object",
        "null"
      ]
    },
    "partitions": {
      "type": [
        "object",
        "null"
      ]
    },
    "row_count": {
      "minimum": 1,
      "type": "integer"
    },
    "sample_id_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "split_manifest.v1"
    },
    "split_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "split_id": {
      "minLength": 1,
      "type": "string"
    },
    "strategy": {
      "enum": [
        "iid",
        "ood"
      ]
    }
  },
  "required": [
    "schema_version",
    "split_id",
    "dataset_id",
    "dataset_version",
    "dataset_content_hash",
    "strategy",
    "algorithm_version",
    "created_at",
    "git_commit",
    "git_tree",
    "git_branch",
    "git_dirty",
    "configuration",
    "sample_id_hash",
    "row_count",
    "partitions",
    "folds",
    "counts",
    "observed_ratios",
    "split_hash",
    "manifest_content_hash"
  ],
  "title": "Catalysis Fixed Split Manifest",
  "type": "object"
}
